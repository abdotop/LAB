# Cloudinary Configuration
# Copy this file to .env and fill in your actual credentials

# Your Cloudinary cloud name (required)
CLOUDINARY_CLOUD_NAME=your_cloud_name_here

# Your Cloudinary API key (required)
CLOUDINARY_API_KEY=your_api_key_here

# Your Cloudinary API secret (required)
CLOUDINARY_API_SECRET=your_api_secret_here

# Optional: Custom secure key for authenticated URLs
CLOUDINARY_SECURE_KEY=your_custom_secure_key

# Optional: Default upload folder
CLOUDINARY_DEFAULT_FOLDER=tmp

# Optional: Enable debug logging
CLOUDINARY_DEBUG=false